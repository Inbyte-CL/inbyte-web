---
import { humanize } from "@/js/textUtils";

interface Props {
	category: string | undefined;
	count?: number;
	class?: string;
}

const { category, count, class: className } = Astro.props as Props;
---

{
	category && (
		<span class:list={["w-auto", className]}>
			<span class="bg-muted/50 rounded-full px-4 py-3 text-sm tracking-tighter md:px-6 md:py-3.5">
				{humanize(category)}
				{count !== undefined && <span class="mt-0.5 ml-1 text-xs opacity-70">({count})</span>}
			</span>
		</span>
	)
}
