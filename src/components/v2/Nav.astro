---
import { Image } from "astro:assets";
import Logo from "@/assets/images/Inbyte-Logo.png";

const links = [
	{ text: "Vending", href: "/vending" },
	{ text: "Parking", href: "/parking" },
	{ text: "POS MDB", href: "/pos-mdb-vending" },
	{ text: "Telemetría", href: "/telemetria-vending" },
	{ text: "Blog", href: "/blog" },
];
---

<header class="v2-nav">
	<div class="v2-container v2-nav__inner">
		<a class="v2-nav__brand" href="/v2/" aria-label="INBYTE">
			<Image src={Logo} alt="INBYTE" height={28} />
		</a>

		<nav class="v2-nav__links" aria-label="Principal">
			{links.map((link) => <a href={link.href}>{link.text}</a>)}
		</nav>

		<div class="v2-nav__actions">
			<a class="v2-btn v2-btn--ghost" href="/">Ver sitio actual</a>
			<a class="v2-btn v2-btn--primary" href="/contact">Contactar</a>
			<button
				class="v2-nav__toggle"
				type="button"
				aria-label="Abrir menú"
				aria-expanded="false"
				aria-controls="v2-mobile-nav"
				data-v2-nav-toggle
			>
				<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
					<path d="M4 7h16M4 12h16M4 17h16"></path>
				</svg>
			</button>
		</div>
	</div>
	<div class="v2-nav__mobile" id="v2-mobile-nav" data-v2-mobile-nav>
		{links.map((link) => <a href={link.href}>{link.text}</a>)}
		<a href="/contact">Contactar</a>
	</div>
</header>

<script>
	const toggle = document.querySelector("[data-v2-nav-toggle]");
	const mobile = document.querySelector("[data-v2-mobile-nav]");
	toggle?.addEventListener("click", () => {
		const open = mobile?.classList.toggle("is-open");
		toggle.setAttribute("aria-expanded", open ? "true" : "false");
	});
</script>
