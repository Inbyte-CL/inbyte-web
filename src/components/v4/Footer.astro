---
import { Image } from "astro:assets";
import Logo from "@/assets/images/Inbyte-Logo.png";
---

<footer class="v4-footer">
	<div class="v4-container">
		<div class="v4-footer__grid">
			<div class="v4-footer__brand">
				<a class="v4-nav__brand" href="/v4/" aria-label="INBYTE">
					<Image src={Logo} alt="INBYTE" height={24} />
				</a>
				<p>
					POS MDB, pagos electrónicos, telemetría y dashboards BI para vending y autoservicio en
					Chile.
				</p>
			</div>
			<div class="v4-footer__col">
				<h4>Soluciones</h4>
				<a href="/vending">Vending</a>
				<a href="/parking">Parking</a>
				<a href="/pos-mdb-vending">POS MDB</a>
				<a href="/telemetria-vending">Telemetría</a>
			</div>
			<div class="v4-footer__col">
				<h4>Recursos</h4>
				<a href="/blog">Blog</a>
				<a href="/faq">FAQ</a>
				<a href="/autoservicio-vending">Autoservicio</a>
			</div>
			<div class="v4-footer__col">
				<h4>Empresa</h4>
				<a href="/contact">Contacto</a>
				<a href="/">Sitio actual</a>
				<a href="/v3/">Prototipo v3</a>
			</div>
		</div>
		<div class="v4-footer__bottom">© {new Date().getFullYear()} INBYTE · Prototipo /v4 (noindex)</div>
	</div>
</footer>
