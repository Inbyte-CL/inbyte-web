---
import { Image } from "astro:assets";
import Logo from "@/assets/images/Inbyte-Logo.png";

const links = [
	{ text: "Vending", href: "/vending" },
	{ text: "Parking", href: "/parking" },
	{ text: "POS MDB", href: "/pos-mdb-vending" },
	{ text: "Telemetría", href: "/telemetria-vending" },
	{ text: "Blog", href: "/blog" },
];
---

<div class="v4-nav-wrap">
	<header class="v4-nav">
		<a class="v4-nav__brand" href="/v4/" aria-label="INBYTE">
			<Image src={Logo} alt="INBYTE" height={24} />
		</a>
		<nav class="v4-nav__links" aria-label="Principal">
			{links.map((link) => <a href={link.href}>{link.text}</a>)}
		</nav>
		<div class="v4-nav__actions">
			<a class="v4-btn v4-btn--ghost" href="/">Sitio actual</a>
			<a class="v4-btn v4-btn--primary" href="/contact">Contactar <span aria-hidden="true">↗</span></a>
			<button
				class="v4-nav__toggle"
				type="button"
				aria-label="Abrir menú"
				aria-expanded="false"
				aria-controls="v4-mobile-nav"
				data-v4-nav-toggle
			>
				<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
					<path d="M4 7h16M4 12h16M4 17h16"></path>
				</svg>
			</button>
		</div>
	</header>
	<div class="v4-nav__mobile" id="v4-mobile-nav" data-v4-mobile-nav>
		{links.map((link) => <a href={link.href}>{link.text}</a>)}
		<a href="/contact">Contactar</a>
	</div>
</div>

<script>
	const toggle = document.querySelector("[data-v4-nav-toggle]");
	const mobile = document.querySelector("[data-v4-mobile-nav]");
	toggle?.addEventListener("click", () => {
		const open = mobile?.classList.toggle("is-open");
		toggle.setAttribute("aria-expanded", open ? "true" : "false");
	});
</script>
