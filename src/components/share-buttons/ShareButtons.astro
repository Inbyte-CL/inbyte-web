---
import type { HTMLAttributes } from "astro/types";
interface Props extends HTMLAttributes<"a"> {
	title: string;
	url: URL; // full URL, including "https://" Easiest way is in BlogLayout.astro `const url = Astro.url.toString();``
	x?: boolean;
	facebook?: boolean;
	linkedin?: boolean;
	pinterest?: boolean;
	whatsapp?: boolean;
	email?: boolean; // include email button
	linktext?: string; // where possible, includes this text in the share link when a user clicks the button (ex. Twitter)
	class?: string;
}

const {
	x = true,
	facebook = true,
	linkedin = true,
	pinterest = false,
	whatsapp = false,
	email = false,
	url,
	title,
	linktext = "Lee este artículo de Inbyte",
	class: className,
	...rest
} = Astro.props as Props;

let validtext = linktext.replace(/ /g, "%20");
---

{
	x && (
		<a
			class={`share-button ${className}`}
			href={`https://twitter.com/intent/tweet?url=${url}&text=${validtext}`}
			target="_blank"
			rel="noopener noreferrer"
			aria-label="Compartir en Twitter"
			{...rest}
		>
			<div class="sr-only">Compartir en</div>
			Twitter
		</a>
	)
}
{
	facebook && (
		<a
			class={`share-button ${className}`}
			href={`https://www.facebook.com/sharer/sharer.php?u=${url}`}
			target="_blank"
			rel="noopener noreferrer"
			aria-label="Compartir en Facebook"
			{...rest}
		>
			<div class="sr-only">Compartir en</div>
			Facebook
		</a>
	)
}
{
	linkedin && (
		<a
			class={`share-button ${className}`}
			href={`https://www.linkedin.com/shareArticle?mini=true&url=${url}`}
			target="_blank"
			rel="noopener noreferrer"
			aria-label="Compartir en Linkedin"
			{...rest}
		>
			<div class="sr-only">Compartir en</div>
			Linkedin
		</a>
	)
}
{
	pinterest && (
		<a
			class={`share-button ${className}`}
			href={`https://pinterest.com/pin/create/button/?url=${url}&media=&description=${validtext}`}
			target="_blank"
			rel="noopener noreferrer"
			aria-label="Compartir en Pinterest"
			{...rest}
		>
			<div class="sr-only">Compartir en</div>
			Pinterest
		</a>
	)
}
{
	whatsapp && (
		<a
			class={`share-button ${className}`}
			href={`https://wa.me/?text=${validtext} ${url}`}
			target="_blank"
			rel="noopener noreferrer"
			aria-label="Compartir en Whatsapp"
			{...rest}
		>
			<div class="sr-only">Compartir en</div>
			Whatsapp
		</a>
	)
}
{
	email && (
		<a
			class={`share-button ${className}`}
			href={`mailto:?subject=${validtext} "${title}"&body=${url}`}
			target="_blank"
			rel="noopener noreferrer"
			aria-label="Compartir por email"
			{...rest}
		>
			<div class="sr-only">Compartir por</div>
			Email
		</a>
	)
}

<style>
	@import "tailwindcss/theme" theme(reference);
	@import "@/styles/tailwind-theme.css" theme(reference);

	/* share buttons on blog posts */
	.share-button {
		@apply hover:text-primary-text text-foreground/80 flex justify-center rounded-md text-sm transition;
	}
</style>
