---
import "@/styles/v5.css";
import Seo from "@/components/seo/Seo.astro";

interface Props {
	title: string;
	description: string;
	image?: ImageMetadata;
	noindex?: boolean;
}

const { title, description, image, noindex = false } = Astro.props;
---

<!doctype html>
<html lang="es" class="v5">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<meta name="theme-color" content="#050607" />
		<link rel="icon" type="image/png" href="/favicons/favicon-96x96.png" sizes="96x96" />
		<link rel="icon" type="image/svg+xml" href="/favicons/favicon.svg" />
		<link rel="shortcut icon" href="/favicons/favicon.ico" />
		<link rel="apple-touch-icon" sizes="180x180" href="/favicons/apple-touch-icon.png" />
		<meta name="apple-mobile-web-app-title" content="INBYTE" />
		<link rel="manifest" href="/favicons/site.webmanifest" />
		<link rel="sitemap" href="/sitemap-index.xml" />
		<link rel="preconnect" href="https://api.fontshare.com" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link href="https://api.fontshare.com/v2/css?f[]=clash-grotesk@400;500;600&display=swap" rel="stylesheet" />
		<link
			href="https://fonts.googleapis.com/css2?family=DM+Sans:opsz,wght@9..40,400;9..40,500;9..40,600&display=swap"
			rel="stylesheet"
		/>
		<Seo type="general" title={title} description={description} image={image} noindex={noindex} />
		<slot name="head" />
	</head>
	<body>
		<a class="v5-skip" href="#contenido">Saltar al contenido</a>
		<div class="v5-wrap">
			<slot />
		</div>
	</body>
</html>
