---
import V5Layout from "@/layouts/v5/V5Layout.astro";
import Nav from "@/components/v5/Nav.astro";
import Footer from "@/components/v5/Footer.astro";
import faqData from "@/config/es/faqData.json";

const faqSchema = {
	"@context": "https://schema.org",
	"@type": "FAQPage",
	mainEntity: faqData.map((item) => ({
		"@type": "Question",
		name: item.question,
		acceptedAnswer: {
			"@type": "Answer",
			text: item.answer.replace(/\s+/g, " ").trim(),
		},
	})),
};
---

<V5Layout
	title="Preguntas frecuentes sobre pagos vending y parking | Inbyte"
	description="Respuestas sobre POS MDB, pagos contactless, telemetría, dashboards BI e integraciones para vending y estacionamientos en Chile."
>
	<Nav />
	<main id="contenido">
		<section class="v5-page-hero v5-page-hero--center v5-band v5-band--dark">
			<div class="v5-container">
				<h1 class="v5-display v5-display--page">Preguntas Frecuentes</h1>
				<p class="v5-lead v5-lead--wide">
					Encuentra respuestas a las preguntas más comunes sobre nuestros sistemas de pago, integraciones y plataforma de telemetría para máquinas expendedoras.
				</p>
			</div>
		</section>
		<section class="v5-section v5-band v5-band--light">
			<div class="v5-container">
				<div class="v5-faq">
					{
						faqData.map((faq) => (
							<details>
								<summary>{faq.question}</summary>
								<p set:html={faq.answer.replace(/\n/g, "<br />")} />
							</details>
						))
					}
				</div>
			</div>
		</section>
	</main>
	<Footer />
	<script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
</V5Layout>
