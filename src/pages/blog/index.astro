---
import V5Layout from "@/layouts/v5/V5Layout.astro";
import Nav from "@/components/v5/Nav.astro";
import Footer from "@/components/v5/Footer.astro";
import { getAllPosts } from "@/js/blogUtils";
import { getLocaleFromUrl } from "@/js/localeUtils";

const currLocale = getLocaleFromUrl(Astro.url);
const posts = await getAllPosts(currLocale);
const featured = posts[0];
const rest = posts.slice(1);
---

<V5Layout
	title="Blog Inbyte | Pagos electrónicos, vending y autoservicio"
	description="Artículos sobre pagos electrónicos, vending inteligente, telemetría, dashboards BI, autoservicio y estacionamientos en Chile."
>
	<Nav />
	<main id="contenido">
		<section class="v5-page-hero v5-page-hero--center v5-band v5-band--dark">
			<div class="v5-container">
				<h1 class="v5-display v5-display--page">Blog sobre pagos electrónicos y autoservicio</h1>
			</div>
		</section>
		<section class="v5-section v5-band v5-band--light">
			<div class="v5-container">
				{
					featured && (
						<a class="v5-post v5-post--featured" href={`/blog/${featured.id}/`}>
							<span class="v5-post__title">{featured.data.title}</span>
							<span class="v5-post__meta">Leer</span>
						</a>
					)
				}
				<div class="v5-posts">
					{
						rest.map((post) => (
							<a class="v5-post" href={`/blog/${post.id}/`}>
								<span class="v5-post__title">{post.data.title}</span>
								<span class="v5-post__meta">Leer</span>
							</a>
						))
					}
				</div>
			</div>
		</section>
	</main>
	<Footer />
</V5Layout>
