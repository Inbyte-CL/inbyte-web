---
import V5Layout from "@/layouts/v5/V5Layout.astro";
import Nav from "@/components/v5/Nav.astro";
import Footer from "@/components/v5/Footer.astro";
import V5ContactForm from "@/components/v5/V5ContactForm.astro";
---

<V5Layout
	title="Contacto Inbyte | Moderniza tu vending o estacionamiento"
	description="Conversemos sobre pagos electrónicos, POS MDB, telemetría y dashboards para máquinas vending, estacionamientos y autoservicio en Chile."
>
	<Nav />
	<main id="contenido">
		<section class="v5-page-hero v5-page-hero--center v5-band v5-band--dark">
			<div class="v5-container">
				<h1 class="v5-display v5-display--page">Contacto</h1>
				<p class="v5-lead v5-lead--wide">
					Completa el formulario y nos pondremos en contacto contigo para ayudarte a modernizar tu operación de vending, parking o autoservicio.
				</p>
			</div>
		</section>
		<section class="v5-section v5-band v5-band--light">
			<div class="v5-container">
				<div class="v5-form-card">
					<V5ContactForm />
				</div>
			</div>
		</section>
	</main>
	<Footer />
</V5Layout>
