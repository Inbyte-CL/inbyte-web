---
import V5Layout from "@/layouts/v5/V5Layout.astro";
import Nav from "@/components/v5/Nav.astro";
import Footer from "@/components/v5/Footer.astro";
import V5Button from "@/components/v5/V5Button";
import { Image } from "astro:assets";
import Parking1 from "@/data/Parking/parking1.png";
import Parking2 from "@/data/Parking/parking2.png";
import DashPark from "@/data/Parking/dashpark.png";
import DashboardParking from "@/data/Parking/Dashboard.png";
import { liftIcons, padLift } from "@/components/v5/liftIcons";

const tariffCards = [
	{ title: "Menores costos", body: "Reducimos las comisiones por cada pago procesado, ayudándote a mantener más de tus ingresos." },
	{ title: "Mayor margen", body: "Al pagar menos en comisiones, tu margen operativo mejora directamente." },
	{ title: "Rentabilidad", body: "Desde el primer día verás el impacto positivo en tus números." },
	{ title: "Escalable", body: "La tarifa se mantiene competitiva incluso cuando tu operación crece." },
];
---

<V5Layout
	title="Sistemas de pago para estacionamientos en Chile | Inbyte"
	description="Integramos POS, tótems de pago, telemetría y dashboards para modernizar estacionamientos, reducir costos y mejorar la experiencia de pago."
>
	<Nav />
	<main id="contenido">
		<section class="v5-page-hero v5-page-hero--center v5-band v5-band--dark">
			<div class="v5-container">
				<h1 class="v5-display v5-display--page">Sistemas de pago para estacionamientos</h1>
				<p class="v5-lead v5-lead--wide">
					Digitalizamos estacionamientos en Chile con pagos electrónicos, integración con tótems, soporte remoto y dashboards de control para operar con más eficiencia.
				</p>
				<div class="v5-hero__ctas v5-hero__ctas--center">
					<V5Button client:visible href="/contact/">Contacto</V5Button>
				</div>
			</div>
		</section>

		<section class="v5-section v5-band v5-band--light">
			<div class="v5-container">
				<div class="v5-copy-split">
					<div>
						<h2 class="v5-h2">Nueva tecnología de pagos</h2>
						<p class="v5-sub">
							La industria del parking está migrando rápidamente hacia sistemas más eficientes, seguros y centrados en el usuario.
						</p>
						<p class="v5-sub">
							En Inbyte implementamos soluciones de pago autoservicio que modernizan cualquier operación de estacionamiento, reducen costos y mejoran la experiencia del cliente desde el primer día.
						</p>
						<p class="v5-sub">
							Nuestra tecnología permite realizar pagos electrónicos rápidos y sin fricción en tótems, cajas de autoservicio y máquinas de cobro de cualquier marca o antigüedad.
						</p>
					</div>
					<div class="v5-page-visual">
						<Image src={Parking1} alt="Sistema de pago autoservicio para estacionamientos" />
					</div>
				</div>
			</div>
		</section>

		<section class="v5-section v5-band v5-band--dark">
			<div class="v5-container">
				<div class="v5-copy-split">
					<div class="v5-page-visual">
						<Image src={Parking2} alt="Integración de POS con tótems de pago Scharfstein" />
					</div>
					<div>
						<h2 class="v5-h2">Integración con Scharftein</h2>
						<p class="v5-sub">Somos especialistas en integrar POS de última generación con máquinas de cobro automáticas.</p>
						<div class="v5-note-stack">
							<div class="v5-note">
								<h3>✔ Integración certificada con equipos Scharfstein</h3>
								<p>
									Estamos 100% integrados con los tótems de Scharfstein utilizados en gran parte de los estacionamientos del país. Nuestra integración es estable, segura y ha sido validada en producción.
								</p>
							</div>
							<div class="v5-note">
								<h3>✔ Podemos integrar cualquier marca o modelo</h3>
								<p>
									No importa el fabricante: tótems antiguos, cajeros automáticos, barreras, validadores, equipos propietarios, sistemas híbridos.
								</p>
								<p>
									Diseñamos módulos y APIs personalizadas para que la integración funcione de manera nativa dentro del flujo del estacionamiento.
								</p>
							</div>
						</div>
					</div>
				</div>
			</div>
		</section>

		<section class="v5-section v5-band v5-band--light">
			<div class="v5-container">
				<div class="v5-head v5-head--center">
					<h2 class="v5-h2">La tarifa más competitiva del mercado gracias a nuestra alianza con Klap</h2>
					<p class="v5-sub">
						Uno de los mayores costos para un operador de estacionamientos es la comisión por transacción. Gracias a nuestra alianza estratégica con Klap, ofrecemos la tarifa más competitiva del mercado en pagos electrónicos para estacionamientos.
					</p>
				</div>
				<div class="v5-page-grid v5-page-grid--two">
					{
						tariffCards.map((card, index) => (
							<article class:list={["v5-card", "v5-lift", index === 0 && "v5-lift--lead"]}>
								<span class="v5-lift__mark" aria-hidden="true">{padLift(index)}</span>
								<div class="v5-lift__icon" aria-hidden="true" set:html={liftIcons[index % liftIcons.length]} />
								<span class="v5-lift__index">{padLift(index)}</span>
								<h3>{card.title}</h3>
								<p>{card.body}</p>
							</article>
						))
					}
				</div>
				<p class="v5-sub" style="margin-top: 24px; text-align: center">
					Esta tarifa es exclusiva para integraciones realizadas a través de Inbyte.
				</p>
			</div>
		</section>

		<section class="v5-section v5-band v5-band--dark">
			<div class="v5-container">
				<div class="v5-copy-split">
					<div>
						<h2 class="v5-h2">Soporte Remoto en Tiempo Real</h2>
						<p class="v5-sub">
							Sabemos que el estacionamiento no se detiene y que una máquina fuera de servicio significa pérdidas.
						</p>
						<p class="v5-sub">
							Por eso ofrecemos soporte remoto en tiempo real para que tu operación siga funcionando sin interrupciones.
						</p>
						<ul class="v5-page-list">
							<li>Diagnóstico inmediato</li>
							<li>Validación de transacciones</li>
							<li>Monitoreo del estado de los POS</li>
							<li>Revisión de logs y flujos de cobro</li>
							<li>Actualizaciones remotas sin detener la operación</li>
						</ul>
					</div>
					<div class="v5-page-visual">
						<Image src={DashPark} alt="Soporte remoto en tiempo real" />
					</div>
				</div>
			</div>
		</section>

		<section class="v5-section v5-band v5-band--light">
			<div class="v5-container">
				<div class="v5-head v5-head--center">
					<h2 class="v5-h2">Dashboard de Control y Telemetría para Parking</h2>
					<p class="v5-sub">
						Integramos los datos de tus máquinas en un panel inteligente para visualizar toda tu operación en tiempo real.
					</p>
				</div>
				<div class="v5-page-visual">
					<Image src={DashboardParking} alt="Dashboard de control para parking" />
				</div>
			</div>
		</section>

		<section class="v5-section v5-band v5-band--dark">
			<div class="v5-container">
				<div class="v5-head v5-head--center">
					<h2 class="v5-h2">Adaptamos la solución a tu infraestructura</h2>
					<p class="v5-sub">
						No importa el tipo ni el tamaño de tu operación. Podemos integrarnos con cualquier arquitectura existente.
					</p>
				</div>
				<div class="v5-pills">
					<span>Centros comerciales</span>
					<span>Edificios corporativos</span>
					<span>Clínicas y hospitales</span>
					<span>Universidades</span>
					<span>Aeropuertos</span>
					<span>Estacionamientos privados</span>
					<span>Estacionamientos públicos</span>
					<span>Garajes automatizados</span>
				</div>
			</div>
		</section>

		<section class="v5-section v5-band v5-band--light">
			<div class="v5-container">
				<div class="v5-cta">
					<h2>Moderniza tu estacionamiento</h2>
					<p>Con pagos electrónicos, integración total y las tarifas más competitivas del mercado.</p>
					<V5Button client:visible href="/contact/">Contacto</V5Button>
				</div>
			</div>
		</section>
	</main>
	<Footer />
</V5Layout>
