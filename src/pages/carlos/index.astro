---
import { Image } from "astro:assets";
import V5Layout from "@/layouts/v5/V5Layout.astro";
import Logo from "@/assets/images/inbyte-logo-circle.png";

export const prerender = true;

const linkedin = "https://www.linkedin.com/in/carlosmoralescaama%C3%B1o/";
---

<V5Layout
	title="Carlos Morales | Inbyte"
	description="Director comercial y tecnológico de Inbyte. Agrega el contacto, visita LinkedIn o inbyte.cl."
	image={Logo}
	noindex={true}
>
	<main id="contenido" class="v5-vcard">
		<article class="v5-vcard__card">
			<div class="v5-vcard__brand">
				<Image src={Logo} alt="Inbyte" width={112} height={112} />
			</div>

			<h1 class="v5-vcard__name">Carlos Morales</h1>
			<p class="v5-vcard__role">Director comercial y tecnológico</p>

			<ul class="v5-vcard__details">
				<li>
					<a href="mailto:carlosm@inbyte.cl">
						<span class="v5-vcard__icon" aria-hidden="true">
							<svg viewBox="0 0 24 24" fill="none">
								<rect x="3.5" y="5.5" width="17" height="13" rx="2.5" stroke="currentColor" stroke-width="1.6"></rect>
								<path d="M4.5 7.5 12 13l7.5-5.5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"></path>
							</svg>
						</span>
						carlosm@inbyte.cl
					</a>
				</li>
				<li>
					<a href="tel:+569445589807">
						<span class="v5-vcard__icon" aria-hidden="true">
							<svg viewBox="0 0 24 24" fill="none">
								<path
									d="M8.2 4.8c.4-.4 1-.5 1.5-.3l2.1.8c.5.2.8.7.8 1.2l-.2 2c0 .4-.2.7-.5.9l-1.3.9a12.4 12.4 0 0 0 5.1 5.1l.9-1.3c.2-.3.5-.5.9-.5l2-.2c.5 0 1 .3 1.2.8l.8 2.1c.2.5.1 1.1-.3 1.5l-1.3 1.3c-.5.5-1.2.7-1.9.6-3.3-.5-6.4-2.3-8.8-4.7S4.4 9.6 3.9 6.3c-.1-.7.1-1.4.6-1.9L8.2 4.8Z"
									stroke="currentColor"
									stroke-width="1.6"
									stroke-linejoin="round"
								></path>
							</svg>
						</span>
						+56 9 445589807
					</a>
				</li>
				<li>
					<a href="https://www.inbyte.cl/" rel="noopener">
						<span class="v5-vcard__icon" aria-hidden="true">
							<svg viewBox="0 0 24 24" fill="none">
								<circle cx="12" cy="12" r="8.2" stroke="currentColor" stroke-width="1.6"></circle>
								<path d="M4.4 12h15.2M12 3.8c2.2 2.3 3.4 5.2 3.4 8.2s-1.2 5.9-3.4 8.2c-2.2-2.3-3.4-5.2-3.4-8.2S9.8 6.1 12 3.8Z" stroke="currentColor" stroke-width="1.6"></path>
							</svg>
						</span>
						inbyte.cl
					</a>
				</li>
			</ul>

			<div class="v5-vcard__actions">
				<a class="v5-btn v5-btn--primary v5-vcard__cta" href="/carlos.vcf">
					<span class="v5-vcard__icon" aria-hidden="true">
						<svg viewBox="0 0 24 24" fill="none">
							<circle cx="10" cy="8" r="3.2" stroke="currentColor" stroke-width="1.7"></circle>
							<path d="M4.6 18.4c.6-2.6 2.7-4.2 5.4-4.2s4.8 1.6 5.4 4.2" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"></path>
							<path d="M18 8v6M15 11h6" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"></path>
						</svg>
					</span>
					Agregar contacto
				</a>
				<a class="v5-btn v5-btn--outline v5-vcard__cta" href={linkedin} rel="noopener noreferrer" target="_blank">
					<span class="v5-vcard__icon" aria-hidden="true">
						<svg viewBox="0 0 24 24" fill="currentColor">
							<path d="M6.5 9.2H3.8V20h2.7V9.2ZM5.15 4C4.2 4 3.5 4.7 3.5 5.6c0 .9.7 1.62 1.64 1.62h.02c.96 0 1.64-.72 1.64-1.62C6.78 4.7 6.1 4 5.15 4ZM20.2 20h-2.7v-5.7c0-1.44-.52-2.42-1.82-2.42-1 0-1.59.67-1.85 1.31-.1.23-.12.55-.12.87V20h-2.7s.04-9.7 0-10.8h2.7v1.53c.36-.55 1-1.34 2.44-1.34 1.78 0 3.12 1.16 3.12 3.66V20Z"></path>
						</svg>
					</span>
					LinkedIn
				</a>
				<a class="v5-btn v5-btn--outline v5-vcard__cta" href="https://www.inbyte.cl/">
					<span class="v5-vcard__icon" aria-hidden="true">
						<svg viewBox="0 0 24 24" fill="none">
							<circle cx="12" cy="12" r="8.2" stroke="currentColor" stroke-width="1.6"></circle>
							<path d="M4.4 12h15.2M12 3.8c2.2 2.3 3.4 5.2 3.4 8.2s-1.2 5.9-3.4 8.2c-2.2-2.3-3.4-5.2-3.4-8.2S9.8 6.1 12 3.8Z" stroke="currentColor" stroke-width="1.6"></path>
						</svg>
					</span>
					Sitio Inbyte
				</a>
			</div>
		</article>
	</main>
</V5Layout>

<style>
	.v5-vcard {
		position: relative;
		z-index: 2;
		min-height: 100dvh;
		display: grid;
		place-items: center;
		padding: max(20px, env(safe-area-inset-top)) 20px max(24px, env(safe-area-inset-bottom));
	}

	.v5-vcard__card {
		width: min(100%, 400px);
		padding: 36px 24px 24px;
		border: 1px solid rgba(255, 255, 255, 0.08);
		border-radius: 32px;
		background:
			radial-gradient(ellipse 80% 60% at 50% 0%, rgba(5, 205, 132, 0.1), transparent 55%),
			#ffffff;
		color: #0a0c0b;
		text-align: center;
	}

	.v5-vcard__brand {
		display: grid;
		place-items: center;
		margin-bottom: 22px;
	}

	.v5-vcard__brand :global(img) {
		width: 112px;
		height: 112px;
		border-radius: 50%;
	}

	.v5-vcard__name {
		margin: 0;
		font-family: var(--v5-display);
		font-size: clamp(1.85rem, 8vw, 2.35rem);
		font-weight: 500;
		letter-spacing: -0.04em;
		line-height: 1.05;
		color: #141816;
	}

	.v5-vcard__role {
		margin: 10px 0 0;
		color: #5b6661;
		font-size: 1rem;
		line-height: 1.4;
	}

	.v5-vcard__details {
		list-style: none;
		margin: 28px 0 0;
		padding: 0;
		display: grid;
		gap: 8px;
		text-align: left;
	}

	.v5-vcard__details a {
		display: flex;
		align-items: center;
		gap: 12px;
		min-height: 48px;
		padding: 0 12px;
		border-radius: 16px;
		color: #141816;
		font-size: 0.98rem;
		font-weight: 500;
		touch-action: manipulation;
		transition: background 180ms var(--v5-ease);
	}

	.v5-vcard__details a:hover,
	.v5-vcard__details a:active {
		background: rgba(5, 205, 132, 0.08);
	}

	.v5-vcard__icon {
		display: grid;
		place-items: center;
		flex: 0 0 28px;
		width: 28px;
		height: 28px;
		color: #05cd84;
	}

	.v5-vcard__icon svg {
		width: 22px;
		height: 22px;
	}

	.v5-vcard__actions {
		display: grid;
		gap: 10px;
		margin-top: 28px;
	}

	.v5-vcard__cta {
		width: 100%;
		min-height: 52px;
		font-size: 15px;
		touch-action: manipulation;
	}

	.v5-vcard__card :global(.v5-btn--outline) {
		border-color: rgba(10, 16, 14, 0.12);
		background: #f4f7f5;
		color: #141816;
	}

	.v5-vcard__card :global(.v5-btn--outline:hover) {
		border-color: rgba(5, 205, 132, 0.45);
		background: rgba(5, 205, 132, 0.1);
	}

	.v5-vcard__card :global(.v5-btn--primary) {
		color: #04140e;
	}

	.v5-vcard__card :global(.v5-btn--primary .v5-vcard__icon) {
		color: #04140e;
	}

	@media (max-height: 700px) {
		.v5-vcard {
			place-items: start center;
		}

		.v5-vcard__brand :global(img) {
			width: 88px;
			height: 88px;
		}

		.v5-vcard__card {
			padding-top: 28px;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.v5-vcard__details a,
		.v5-vcard__cta {
			transition: none;
		}
	}
</style>
